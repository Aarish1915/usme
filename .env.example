# =============================================================
#  USAME API — Environment Variable Template
#  Copy this file to .env and fill in your own values.
#  NEVER put real values in this file.
# =============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/usame_db"

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET="replace-with-a-256-bit-random-secret"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_SECRET="replace-with-a-different-256-bit-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ── OTP ───────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300

# ── AWS ───────────────────────────────────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_S3_QUARANTINE_BUCKET="usame-quarantine-dev"
AWS_S3_CLEAN_BUCKET="usame-clean-dev"
AWS_S3_PDF_BUCKET="usame-pdfs-dev"

# ── Email (AWS SES) ────────────────────────────────────────
SES_FROM_EMAIL="noreply@usame.uk.gov.in"

# ── SMS (Twilio / MSG91) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-phone-number"

MSG91_API_KEY="your-msg91-api-key"
MSG91_SENDER_ID="USAME"
MSG91_TEMPLATE_ID="your-template-id"

# ── Redis (for Bull.js queue) ──────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379

# ── App ───────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ── Encryption ────────────────────────────────────────────
ENCRYPTION_KEY="replace-with-32-char-hex-key"

# ── CAPTCHA ───────────────────────────────────────────────
RECAPTCHA_SECRET_KEY="your-google-recaptcha-secret"
